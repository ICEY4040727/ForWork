{
  "name": "@forwork/tool-web",
  "description": "Model-facing web tools (web_search, web_fetch) over the ForWork web capability seam (ctx.web)",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ICEY4040727/ForWork.git",
    "directory": "packages/web/tool-web"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@forwork/cordis": "workspace:~",
    "@forwork/llm": "workspace:*",
    "@forwork/system-prompt": "workspace:*",
    "@forwork/tools": "workspace:*",
    "@forwork/web": "workspace:*"
  },
  "dependencies": {
    "@forwork/output-retention": "workspace:*",
    "@forwork/util-values": "workspace:*",
    "@forwork/schemastery": "workspace:~",
    "@joplin/turndown-plugin-gfm": "^1.0.67",
    "turndown": "^7.2.4"
  },
  "devDependencies": {
    "@forwork/cordis": "workspace:~",
    "@forwork/agent": "workspace:*",
    "@forwork/llm": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/spill-local": "workspace:*",
    "@forwork/spill-policy": "workspace:*",
    "@forwork/system-prompt": "workspace:*",
    "@forwork/tool-call-timeout-policy": "workspace:*",
    "@forwork/tool-executor-native": "workspace:*",
    "@forwork/tool-testkit": "workspace:*",
    "@forwork/tools": "workspace:*",
    "@forwork/web": "workspace:*",
    "@forwork/web-api": "workspace:*",
    "@forwork/web-fetch-http": "workspace:*",
    "@types/turndown": "^5.0.6",
    "@forwork/scope": "workspace:*",
    "@forwork/token-meter": "workspace:*",
    "@forwork/launch-environment": "workspace:*"
  }
