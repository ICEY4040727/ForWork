{
  "name": "@forwork/web-search-deepseek",
  "description": "DeepSeek-backed search provider (native web_search via the Anthropic-compatible API) for the ForWork web capability seam (ctx.web)",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ICEY4040727/ForWork.git",
    "directory": "packages/web/web-search-deepseek"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@forwork/agent": "workspace:*",
    "@forwork/credentials": "workspace:*",
    "@forwork/deepseek-account": "workspace:*",
    "@forwork/launch-environment": "workspace:*",
    "@forwork/llm-deepseek": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/web": "workspace:*",
    "@forwork/cordis": "workspace:~"
  },
  "dependencies": {
    "@forwork/schemastery": "workspace:~"
  },
  "devDependencies": {
    "@forwork/agent": "workspace:*",
    "@forwork/credentials": "workspace:*",
    "@forwork/credentials-local": "workspace:*",
    "@forwork/deepseek-account": "workspace:*",
    "@forwork/launch-environment": "workspace:*",
    "@forwork/llm-deepseek": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/web": "workspace:*",
    "@forwork/cordis": "workspace:~",
    "@forwork/http-proxy": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@forwork/deepseek-account": {
      "optional": true
    }
  }
}
