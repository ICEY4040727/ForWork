{
  "name": "@forwork/subagent",
  "description": "Abstract subagent seam (ctx.subagents): named-provider registry for delegating to child agents",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/subagent/subagent"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@forwork/brand": "workspace:*",
    "@forwork/chunked-list": "workspace:*",
    "@forwork/util-values": "workspace:*",
    "@forwork/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@forwork/cordis": "workspace:~",
    "@forwork/agent": "workspace:*",
    "@forwork/agent-preset-registry": "workspace:*",
    "@forwork/attachment": "workspace:*",
    "@forwork/llm": "workspace:*",
    "@forwork/sandbox": "workspace:*",
    "@forwork/sandbox-policy": "workspace:*",
    "@forwork/scope": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/session-persistence": "workspace:*",
    "@forwork/session-projection": "workspace:*",
    "@forwork/session-query": "workspace:*",
    "@forwork/system-prompt": "workspace:*",
    "@forwork/tools": "workspace:*",
    "@forwork/typert-protocol": "workspace:*",
    "@forwork/user-approval": "workspace:*",
    "@forwork/util-time": "workspace:*",
    "@forwork/permission-presets": "workspace:*",
    "@forwork/workspace": "workspace:*",
    "@forwork/working-directory": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@forwork/agent-preset-registry": {
      "optional": true
    },
    "@forwork/permission-presets": {
      "optional": true
    },
    "@forwork/sandbox": {
      "optional": true
    },
    "@forwork/sandbox-policy": {
      "optional": true
    },
    "@forwork/session-persistence": {
      "optional": true
    },
    "@forwork/session-query": {
      "optional": true
    },
    "@forwork/workspace": {
      "optional": true
    },
    "@forwork/user-approval": {
      "optional": true
    }
  },
  "devDependencies": {
    "@forwork/cordis": "workspace:~",
    "@forwork/agent": "workspace:*",
    "@forwork/agent-preset-registry": "workspace:*",
    "@forwork/attachment": "workspace:*",
    "@forwork/llm": "workspace:*",
    "@forwork/sandbox": "workspace:*",
    "@forwork/sandbox-policy": "workspace:*",
    "@forwork/scope": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/session-persistence": "workspace:*",
    "@forwork/session-projection": "workspace:*",
    "@forwork/session-query": "workspace:*",
    "@forwork/system-prompt": "workspace:*",
    "@forwork/tool-testkit": "workspace:*",
    "@forwork/tools": "workspace:*",
    "@forwork/typert-protocol": "workspace:*",
    "@forwork/user-approval": "workspace:*",
    "@forwork/util-time": "workspace:*",
    "@forwork/permission-presets": "workspace:*",
    "@forwork/workspace": "workspace:*",
    "@forwork/cordis-plugin-include": "workspace:~",
    "@forwork/cordis-plugin-loader": "workspace:~",
    "@forwork/agent-loop": "workspace:*",
    "@forwork/agent-loop-testkit": "workspace:*",
    "@forwork/fs-sandbox": "workspace:*",
    "@forwork/tool-fs": "workspace:*",
