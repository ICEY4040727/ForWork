{  "name": "@forwork/session-document",
  "description": "Host document session primitives: stable identity bindings, version-guarded attributable change records, durable document facts, and the open-document projection and prompt section",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/session/session-document"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "@forwork/cordis": "workspace:~",
    "@forwork/agent": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/session-projection": "workspace:*",
    "@forwork/system-prompt": "workspace:*"
  },
  "devDependencies": {
    "@forwork/cordis": "workspace:~",
    "@forwork/agent": "workspace:*",
    "@forwork/agent-loop-testkit": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/session-projection": "workspace:*",
    "@forwork/system-prompt": "workspace:*"
  }
}
