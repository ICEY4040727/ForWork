{
  "name": "@forwork/client-ui-office-editor",
  "description": "Embedded Office document editor tab for the right Sidebar",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ICEY4040727/ForWork.git",
    "directory": "packages/client/ui-office-editor"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@forwork/api-remotes",
        "@forwork/api-session-controller",
        "@forwork/api-workspace-files",
        "@forwork/client-locale",
        "@forwork/client-resources",
        "@forwork/client-store",
        "@forwork/client-ui-session",
        "@forwork/client-ui-sidebar-right"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "peerDependencies": {
    "@forwork/cordis": "workspace:~"
  },
  "devDependencies": {
    "@forwork/cordis": "workspace:~",
    "@forwork/api-remotes": "workspace:*",
    "@forwork/api-session-controller": "workspace:*",
    "@forwork/api-workspace-files": "workspace:*",
    "@forwork/brand": "workspace:*",
    "@forwork/client-locale": "workspace:*",
    "@forwork/client-resources": "workspace:*",
    "@forwork/client-store": "workspace:*",
    "@forwork/client-ui-dockkit": "workspace:*",
    "@forwork/client-ui-primitives": "workspace:*",
    "@forwork/client-ui-renderer": "workspace:*",
    "@forwork/client-ui-sidebar-documentpreview": "workspace:*",
    "@forwork/client-ui-sidebar-right": "workspace:*",
    "@forwork/client-ui-session": "workspace:*",
    "@forwork/client-ui-slots": "workspace:*",
    "@forwork/office-exchange": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/session-document": "workspace:*",
    "@forwork/typert-protocol": "workspace:*",
    "@forwork/util-values": "workspace:*",
    "@forwork/util-workspace-path": "workspace:*",
    "@testing-library/react": "^16.3.3",
    "@univerjs/core": "1.4.0",
    "@univerjs/preset-docs-core": "1.4.0",
    "@univerjs/preset-sheets-core": "1.4.0",
    "@univerjs/presets": "1.4.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/client.*.js",
    "lib/types/**/*.d.ts"
  ]
}
