{
  "name": "@forwork/client-ui-conversation",
  "description": "Target-neutral Conversation assembly, shell, composer, queue, and view navigation",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/client/ui-conversation"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@forwork/api-session-controller",
        "@forwork/client-file-upload",
        "@forwork/client-locale",
        "@forwork/client-ui-layout",
        "@forwork/client-ui-renderer",
        "@forwork/client-ui-session",
        "@forwork/client-ui-settings",
        "@forwork/client-ui-workspace",
        "@forwork/client-ui-context-menu"
      ],
      "platform": "web"
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "dependencies": {
    "@forwork/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@forwork/cordis": "workspace:~"
  },
  "devDependencies": {
    "@forwork/cordis": "workspace:~",
    "@forwork/api-remotes": "workspace:*",
    "@forwork/api-session-controller": "workspace:*",
    "@forwork/api-workspace-controller": "workspace:*",
    "@forwork/attachment": "workspace:*",
    "@forwork/client-locale": "workspace:*",
    "@forwork/client-file-upload": "workspace:*",
    "@forwork/client-store": "workspace:*",
    "@forwork/client-test-runtime": "workspace:*",
    "@forwork/client-ui-layout": "workspace:*",
    "@forwork/client-ui-primitives": "workspace:*",
    "@forwork/client-ui-renderer": "workspace:*",
    "@forwork/client-ui-session": "workspace:*",
    "@forwork/client-ui-settings": "workspace:*",
    "@forwork/client-ui-workspace": "workspace:*",
    "@forwork/client-ui-slots": "workspace:*",
    "@forwork/commands": "workspace:*",
    "@forwork/goal": "workspace:*",
    "@forwork/llm": "workspace:*",
    "@forwork/llm-retry": "workspace:*",
    "@forwork/plan-mode": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/util-values": "workspace:*",
    "@forwork/token-meter": "workspace:*",
    "@forwork/tool-todo": "workspace:*",
    "@forwork/util-crypto": "workspace:*",
    "@forwork/workspace": "workspace:*",
    "@forwork/file-reference": "workspace:*",
    "@forwork/util-workspace-path": "workspace:*",
    "react": "^18.2.0",
    "@lexical/headless": "^0.49.0",
    "react-dom": "^18.2.0",
    "lexical": "^0.49.0",
    "clsx": "^2.0.0",
    "@lexical/utils": "^0.49.0",
    "@lexical/text": "^0.49.0",
    "@lexical/plain-text": "^0.49.0",
    "@lexical/history": "^0.49.0",
    "@forwork/agent": "workspace:*",
    "@forwork/settings": "workspace:*",
    "@forwork/client-shortcuts": "workspace:*",
    "@forwork/client-product-analytics": "workspace:*",
    "@forwork/message-quotes": "workspace:*",
    "@forwork/session-projection": "workspace:*",
    "@forwork/brand": "workspace:*",
    "zod": "4.4.3",
    "@forwork/client-ui-context-menu": "workspace:*"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.d.ts"
  ]
}
