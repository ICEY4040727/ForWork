{
  "name": "@forwork/experimental-auto-review",
  "description": "Per-tool LLM authorization review for the ForWork Auto permission preset",
  "version": "0.2.2-rc.1",
  "icon": "./icon.svg",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/experimental/auto-review"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./locale/*.json": "./locale/*.json",
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "icon.svg",
    "locale/*.json",
    "docs",
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@forwork/agent": "workspace:*",
    "@forwork/agent-instructions": "workspace:*",
    "@forwork/llm": "workspace:*",
    "@forwork/permission-presets": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/tools": "workspace:*",
    "@forwork/cordis": "workspace:~",
    "@forwork/working-directory": "workspace:*"
  },
  "dependencies": {
    "@forwork/util-values": "workspace:*"
  },
  "devDependencies": {
    "@forwork/agent": "workspace:*",
    "@forwork/agent-instructions": "workspace:*",
    "@forwork/agent-loop": "workspace:*",
    "@forwork/agent-loop-testkit": "workspace:*",
    "@forwork/bash-sandbox": "workspace:*",
    "@forwork/compaction": "workspace:*",
    "@forwork/fs-local": "workspace:*",
    "@forwork/fs-observation-policy": "workspace:*",
    "@forwork/fs-sandbox": "workspace:*",
    "@forwork/llm": "workspace:*",
    "@forwork/llm-deepseek": "workspace:*",
    "@forwork/llm-deepseek-api-key": "workspace:*",
    "@forwork/permission-presets": "workspace:*",
    "@forwork/ptc-runtime-node": "workspace:*",
    "@forwork/sandbox": "workspace:*",
    "@forwork/sandbox-policy": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/session-projection": "workspace:*",
    "@forwork/shell": "workspace:*",
    "@forwork/shell-env": "workspace:*",
    "@forwork/subagent": "workspace:*",
    "@forwork/subprocess-local": "workspace:*",
    "@forwork/system-prompt": "workspace:*",
    "@forwork/tool-bash": "workspace:*",
    "@forwork/tool-executor-native": "workspace:*",
    "@forwork/tool-executor-ptc": "workspace:*",
    "@forwork/tool-fs": "workspace:*",
    "@forwork/tool-subagent": "workspace:*",
    "@forwork/tool-testkit": "workspace:*",
    "@forwork/tools": "workspace:*",
    "@forwork/user-approval": "workspace:*",
    "@forwork/cordis": "workspace:~",
    "@forwork/working-directory": "workspace:*"
  },
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  }
}
