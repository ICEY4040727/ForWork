{
  "name": "@forwork/api-remotes",
  "description": "Remote BFF assembly for application-selected Host capabilities",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ICEY4040727/ForWork.git",
    "directory": "packages/api/remotes"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "dsh": {
    "client": {
      "inject": [
        "@forwork/api-gateway"
      ],
      "platform": "web",
      "immediately": true
    }
  },
  "scripts": {
    "bundle": "tsdown",
    "watch": "tsdown --watch"
  },
  "license": "MIT",
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/client.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts"
  ],
  "dependencies": {
    "@forwork/deque": "workspace:*",
    "@forwork/util-values": "workspace:*"
  },
  "peerDependencies": {
    "@forwork/cordis": "workspace:~",
    "@forwork/scope": "workspace:*"
  },
  "devDependencies": {
    "@forwork/agent": "workspace:*",
    "@forwork/agent-preset-registry": "workspace:*",
    "@forwork/api-gateway": "workspace:*",
    "@forwork/api-job-controller": "workspace:*",
    "@forwork/api-session-controller": "workspace:*",
    "@forwork/api-settings-controller": "workspace:*",
    "@forwork/api-workspace-controller": "workspace:*",
    "@forwork/api-workspace-files": "workspace:*",
    "@forwork/client-connection": "workspace:*",
    "@forwork/client-file-upload": "workspace:*",
    "@forwork/commands": "workspace:*",
    "@forwork/cordis-host-runner": "workspace:*",
    "@forwork/credentials": "workspace:*",
    "@forwork/file-reference": "workspace:*",
    "@forwork/goal": "workspace:*",
    "@forwork/host-plugin-inventory": "workspace:*",
    "@forwork/llm": "workspace:*",
    "@forwork/message-feedback": "workspace:*",
    "@forwork/permission-presets": "workspace:*",
    "@forwork/schedule": "workspace:*",
    "@forwork/scope": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/session-reference": "workspace:*",
    "@forwork/settings": "workspace:*",
    "@forwork/subagent": "workspace:*",
    "@forwork/typert-protocol": "workspace:*",
    "@forwork/user-approval": "workspace:*",
    "@forwork/user-questions": "workspace:*",
    "@forwork/cordis": "workspace:~",
    "zod": "4.4.3",
    "@forwork/command-feedback": "workspace:*",
    "@forwork/api-terminal-controller": "workspace:*",
    "@forwork/plugin-manager": "workspace:*",
    "@forwork/mcp-manager": "workspace:*",
    "@forwork/plugin-market": "workspace:*",
    "@forwork/client-ui-plugin-manager": "workspace:*",
    "@forwork/office-to-pdf": "workspace:*",
    "@forwork/office-exchange": "workspace:*",
    "@forwork/api-account-controller": "workspace:*",
    "@forwork/deepseek-account": "workspace:*",
    "@forwork/client-product-analytics": "workspace:*",
    "@forwork/agent-team": "workspace:*",
    "@forwork/client-ui-trajectory": "workspace:*",
    "@forwork/web": "workspace:*"
  }
}
