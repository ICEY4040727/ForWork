{
  "name": "@forwork/llm-pi-ai",
  "description": "pi-ai-backed DeepSeek adapter for the ForWork LLM seam (design-verification twin of dsh-llm-deepseek)",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/llm/llm-pi-ai"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@forwork/cordis": "workspace:~",
    "@forwork/cordis-plugin-loader": "workspace:~",
    "@forwork/attachment": "workspace:*",
    "@forwork/authorization": "workspace:*",
    "@forwork/credentials": "workspace:*",
    "@forwork/fs": "workspace:*",
    "@forwork/launch-environment": "workspace:*",
    "@forwork/llm": "workspace:*",
    "@forwork/timeout": "workspace:*"
  },
  "dependencies": {
    "@forwork/brand": "workspace:*",
    "@forwork/util-values": "workspace:*",
    "@forwork/schemastery": "workspace:~",
    "@earendil-works/pi-ai": "^1.3.0"
  },
  "devDependencies": {
    "@forwork/cordis": "workspace:~",
    "@forwork/cordis-plugin-loader": "workspace:~",
    "@forwork/agent-loop-testkit": "workspace:*",
    "@forwork/attachment": "workspace:*",
    "@forwork/authorization": "workspace:*",
    "@forwork/credentials": "workspace:*",
    "@forwork/fs": "workspace:*",
    "@forwork/http-proxy": "workspace:*",
    "@forwork/launch-environment": "workspace:*",
    "@forwork/llm": "workspace:*",
    "@forwork/llm-deepseek": "workspace:*",
    "@forwork/llm-deepseek-api-key": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/settings": "workspace:*",
    "@forwork/timeout": "workspace:*",
    "@forwork/tool-testkit": "workspace:*",
    "@forwork/tools": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@forwork/cordis-plugin-loader": {
      "optional": true
    }
  }
}
