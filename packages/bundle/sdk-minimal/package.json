{
  "name": "@forwork/sdk-minimal",
  "description": "The standalone minimal SDK profile bundle: JSON-RPC, one DeepSeek adapter, persistent shell, and JSONL sessions",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ICEY4040727/ForWork.git",
    "directory": "packages/bundle/sdk-minimal"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./src/*": "./src/*",
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "cordis.patch.yml",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "dependencies": {
    "@forwork/cordis-plugin-timer": "workspace:~",
    "@forwork/agent": "workspace:*",
    "@forwork/agent-loop": "workspace:*",
    "@forwork/attachment-local": "workspace:*",
    "@forwork/compaction-basic": "workspace:*",
    "@forwork/compaction-image-offload": "workspace:*",
    "@forwork/deepseek-llm-api-extensions": "workspace:*",
    "@forwork/jobs-local": "workspace:*",
    "@forwork/llm": "workspace:*",
    "@forwork/llm-deepseek-api-key": "workspace:*",
    "@forwork/llm-retry": "workspace:*",
    "@forwork/mcp-resources": "workspace:*",
    "@forwork/plugin-package-inventory-deepseek": "workspace:*",
    "@forwork/sandbox-local": "workspace:*",
    "@forwork/sandbox-policy": "workspace:*",
    "@forwork/sdk-app": "workspace:*",
    "@forwork/sdk-jsonrpc-server": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/session-checkpoint-policy": "workspace:*",
    "@forwork/session-log-deepseek": "workspace:*",
    "@forwork/session-persistence-jsonl": "workspace:*",
    "@forwork/session-projection": "workspace:*",
    "@forwork/session-title": "workspace:*",
    "@forwork/subprocess-local": "workspace:*",
    "@forwork/system-prompt": "workspace:*",
    "@forwork/terminal": "workspace:*",
    "@forwork/terminal-bash": "workspace:*",
    "@forwork/token-meter": "workspace:*",
    "@forwork/tool-bash-persistent": "workspace:*",
    "@forwork/tool-executor-native": "workspace:*",
    "@forwork/tool-fs": "workspace:*",
    "@forwork/tool-pwsh-persistent": "workspace:*",
    "@forwork/tools": "workspace:*",
    "@forwork/working-directory": "workspace:*",
    "@forwork/tool-working-directory": "workspace:*",
    "@forwork/fs-local": "workspace:*"
  },
  "peerDependencies": {
    "@forwork/cordis": "workspace:~"
  },
  "devDependencies": {
    "@forwork/cordis": "workspace:~"
  }
}
