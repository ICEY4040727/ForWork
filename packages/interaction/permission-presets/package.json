{
  "name": "@forwork/permission-presets",
  "description": "User-facing permission presets (ctx.permissionPresets) for the ForWork: one product-level Permissions select bundling the sandbox-mode and approval-policy knobs, written through to their own session events",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ICEY4040727/ForWork.git",
    "directory": "packages/interaction/permission-presets"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types/types.d.ts",
      "default": "./lib/types/types.js"
    },
    "./client": {
      "types": "./lib/types/client.d.ts",
      "default": "./lib/types/client.js"
    },
    "./typert": {
      "types": "./lib/typert.host.d.ts",
      "default": "./lib/typert.host.js"
    },
    "./remote": {
      "types": "./lib/typert.remote-client.d.ts",
      "default": "./lib/typert.remote-client.js"
    },
    "./src/*": "./src/*",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.js",
    "lib/types/**/*.d.ts",
    "lib/typert.host.js",
    "lib/typert.host.d.ts",
    "lib/typert.remote-client.js",
    "lib/typert.remote-client.d.ts"
  ],
  "license": "MIT",
  "peerDependencies": {
    "@forwork/agent": "workspace:*",
    "@forwork/shell": "workspace:*",
    "@forwork/commands": "workspace:*",
    "@forwork/sandbox": "workspace:*",
    "@forwork/sandbox-policy": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/session-projection": "workspace:*",
    "@forwork/typert-protocol": "workspace:*",
    "@forwork/user-approval": "workspace:*",
    "@forwork/cordis": "workspace:~"
  },
  "dependencies": {
    "@forwork/schemastery": "workspace:~",
    "zod": "4.4.3"
  },
  "devDependencies": {
    "@forwork/agent": "workspace:*",
    "@forwork/shell": "workspace:*",
    "@forwork/commands": "workspace:*",
    "@forwork/sandbox": "workspace:*",
    "@forwork/sandbox-policy": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/session-projection": "workspace:*",
    "@forwork/typert-protocol": "workspace:*",
    "@forwork/user-approval": "workspace:*",
    "@forwork/cordis": "workspace:~",
    "@forwork/settings": "workspace:*",
    "@forwork/agent-loop-testkit": "workspace:*"
  }
}
