{
  "name": "@forwork/sdk-jsonrpc-server",
  "description": "Stdio JSON-RPC server plugin for out-of-process DeepSeek Harness SDK clients",
  "version": "0.2.2-rc.1",
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/deepseek-ai/deepseek-harness.git",
    "directory": "packages/sdk/server"
  },
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/types/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.js"
    },
    "./src/*": "./src/*",
    "./locale/*.json": "./locale/*.json",
    "./package.json": "./package.json"
  },
  "files": [
    "locale/*.json",
    "lib/index.js",
    "lib/types/**/*.d.ts"
  ],
  "license": "MIT",
  "dependencies": {
    "@forwork/brand": "workspace:*",
    "@forwork/schemastery": "workspace:~"
  },
  "peerDependencies": {
    "@forwork/cordis": "workspace:~",
    "@forwork/agent": "workspace:*",
    "@forwork/attachment": "workspace:*",
    "@forwork/commands": "workspace:*",
    "@forwork/goal": "workspace:*",
    "@forwork/llm": "workspace:*",
    "@forwork/llm-deepseek-api-key": "workspace:*",
    "@forwork/schedule": "workspace:*",
    "@forwork/scope": "workspace:*",
    "@forwork/sdk-protocol": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/subagent": "workspace:*",
    "@forwork/user-approval": "workspace:*",
    "@forwork/user-questions": "workspace:*",
    "@forwork/working-directory": "workspace:*"
  },
  "devDependencies": {
    "@forwork/cordis": "workspace:~",
    "@forwork/cordis-plugin-loader": "workspace:~",
    "@forwork/agent": "workspace:*",
    "@forwork/agent-loop": "workspace:*",
    "@forwork/agent-loop-testkit": "workspace:*",
    "@forwork/attachment": "workspace:*",
    "@forwork/command-compact": "workspace:*",
    "@forwork/command-goal": "workspace:*",
    "@forwork/commands": "workspace:*",
    "@forwork/compaction-basic": "workspace:*",
    "@forwork/goal": "workspace:*",
    "@forwork/goal-round-driver": "workspace:*",
    "@forwork/llm": "workspace:*",
    "@forwork/llm-deepseek-api-key": "workspace:*",
    "@forwork/permission-presets": "workspace:*",
    "@forwork/plan-mode": "workspace:*",
    "@forwork/sandbox-policy": "workspace:*",
    "@forwork/schedule": "workspace:*",
    "@forwork/scope": "workspace:*",
    "@forwork/sdk-protocol": "workspace:*",
    "@forwork/session": "workspace:*",
    "@forwork/session-persistence-jsonl": "workspace:*",
    "@forwork/session-projection": "workspace:*",
    "@forwork/shell": "workspace:*",
    "@forwork/subagent": "workspace:*",
    "@forwork/token-meter": "workspace:*",
    "@forwork/tool-goal": "workspace:*",
    "@forwork/tools": "workspace:*",
    "@forwork/user-approval": "workspace:*",
    "@forwork/user-questions": "workspace:*",
    "@forwork/working-directory": "workspace:*"
  }
